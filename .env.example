# ============================================================
# Application Settings
# ============================================================
APP_NAME="GenAI RAG Backend"
APP_VERSION="1.0.0"
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ============================================================
# API Server
# ============================================================
HOST=0.0.0.0
PORT=8000
WORKERS=1                    # Increase for production (e.g. 4)

# ============================================================
# PostgreSQL Database
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db

# Composed DATABASE_URL (used by SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_db

# Sync URL for Alembic migrations (psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://rag_user:rag_password@localhost:5432/rag_db

# ============================================================
# OpenAI API
# ============================================================
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.0

# ============================================================
# RAG Settings
# ============================================================
CHUNK_SIZE=512               # Token size per chunk
CHUNK_OVERLAP=50             # Overlap between chunks
TOP_K_RESULTS=5              # Number of similar chunks to retrieve
SIMILARITY_THRESHOLD=0.7     # Minimum similarity score (0-1)

# ============================================================
# Security
# ============================================================
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# CORS
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================
# Redis Cache
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_EMBEDDING=86400       # 24h — embedding vectors are deterministic
REDIS_TTL_RAG_QUERY=3600        # 1h  — query → answer pairs
REDIS_TTL_DOCUMENT_LIST=300     # 5m  — document listing (invalidated on write)
CACHE_ENABLED=true

# ============================================================
# File Upload
# ============================================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt

# ============================================================
# Monitoring
# ============================================================
ENABLE_METRICS=true
METRICS_PATH=/metrics
